# -*- coding: utf-8 -*-
"""PyInstaller 打包配置：库街区探索助手（Windows onedir）。

调用方式（两种等价，**推荐在项目根目录执行**，build_windows.bat 就是这样做）：

    pyinstaller packaging/kumap.spec --noconfirm
    python -m PyInstaller packaging/kumap.spec --noconfirm

路径约定（本文件内已自洽，请连同下面两条一起理解）：
  * PyInstaller 会把全局变量 ``SPECPATH`` 设为**本 spec 文件所在目录**的绝对路径，
    也就是 ``<项目根>/packaging``；因此项目根 = ``os.path.dirname(SPECPATH)``。
  * 本文件所有路径都由 ``ROOT`` / ``SRC`` 拼出来，不依赖当前工作目录，
    所以从哪个目录调用产物都一致；但 ``build/`` 与 ``dist/`` 始终生成在**当前工作目录**，
    所以请务必从项目根目录运行，否则会在别处生成 build/dist。

产物：dist/<APP_NAME>/<APP_NAME>.exe（APP_NAME 默认 KuroMapHelper，见下）。
"""

import os

# ------------------------------------------------------------------ 基础路径
SPECPATH_ABS = os.path.abspath(SPECPATH)          # <ROOT>/packaging
ROOT = os.path.dirname(SPECPATH_ABS)              # 项目根目录
SRC = os.path.join(ROOT, "src")                   # src 布局：kumap 包在这里
PKG_RESOURCES = os.path.join(SRC, "kumap", "resources")
BUILD_DIR = os.path.join(ROOT, "build")
VERSION_FILE = os.path.join(SPECPATH_ABS, "version_info.txt")

# ------------------------------------------------------------------ 产物名字
# 默认用 ASCII 名字，避免部分 Windows 环境 / 杀软 / CI 对非 ASCII 路径的兼容问题。
# 想交付「库街区探索助手.exe」，两种改法任选其一：
#   1) 打包前设置环境变量：set "KUMAP_EXE_NAME=库街区探索助手"（build_windows.bat 会透传）
#   2) 直接把下一行的默认值改成 "库街区探索助手"
# 改了名字后产物为 dist/<名字>/<名字>.exe，功能与数据目录位置都不受影响
# （数据目录固定在 %APPDATA%\KuroMapHelper，由 core/paths.py 决定，与 exe 名无关）。
APP_NAME = os.environ.get("KUMAP_EXE_NAME") or "KuroMapHelper"

# ------------------------------------------------------------------ 入口脚本
# src/kumap/main.py 与 __main__.py 都使用包内相对导入（from .core import ...），
# 直接把其中任意一个文件当 PyInstaller 入口会在运行期报「相对导入没有已知父包」。
# 所以这里在 build/ 下生成一个极小的启动壳，等价于开发环境的 `python -m kumap.main`：
# 它作为顶层脚本运行，真正的代码仍以 kumap 包的形式被收集。
os.makedirs(BUILD_DIR, exist_ok=True)
ENTRY = os.path.join(BUILD_DIR, "kumap_launcher.py")
with open(ENTRY, "w", encoding="utf-8") as _fh:
    _fh.write(
        '"""Generated by packaging/kumap.spec -- do not edit, do not commit.'
        '\n\n启动壳：等价于开发环境的 python -m kumap.main。\n"""\n'
        "from kumap.main import main\n\n"
        'if __name__ == "__main__":\n'
        "    raise SystemExit(main())\n"
    )

# ------------------------------------------------------------------ Analysis
# hiddenimports 留空是有意为之：
#   * PySide6 有 PyInstaller 官方 hook，QtCore/QtGui/QtWidgets/QtNetwork 以及
#     core/auth.py、ui/main_window.py 里用到的插件（平台、样式、图像格式）都会被自动收集；
#   * 函数体内部的 import（如 ui/login_dialog.py、core/recognizer.py）
#     同样会被模块图静态分析发现，不需要手写 hiddenimports。
# excludes 留空。注意 cv2 / numpy / mss 是**可选**依赖：
#   * 当前环境没装它们 -> PyInstaller 根本找不到，自然不会打进 exe，
#     程序运行时会把识图功能降级为「手动定位」，无需任何额外配置；
#   * 当前环境装了它们但你**不想**让 exe 带识图（体积能小一大截），
#     就把 excludes 写成： excludes=["cv2", "numpy", "mss"]
#     （core/recognizer.py 的 try/except 导入会让识图自动禁用，行为同上）。
a = Analysis(
    [ENTRY],
    pathex=[SRC, ROOT],
    binaries=[],
    # 整个 resources 目录原样映射到包内 kumap/resources：
    # core/paths.py 的 resource_root() 在 frozen 模式下取 sys._MEIPASS/kumap/resources，
    # 打包后示例点位/路线与占位底图就是靠这条 datas 找到的，不要改成别的目标名。
    datas=[(PKG_RESOURCES, os.path.join("kumap", "resources"))],
    hiddenimports=[],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
)

pyz = PYZ(a.pure)

# console=False：桌面程序，双击 exe 不弹黑色控制台窗口；
# 异常由 main.py 里装的 excepthook 写进 <数据目录>/app.log。
exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name=APP_NAME,
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    version=VERSION_FILE,
    # icon：仓库内没有 .ico 资源（托盘/窗口图标由 ui/tray.py 运行时自绘），
    # 若要自定义图标，把 ico 放到 packaging/ 下再打开下一行：
    # icon=os.path.join(SPECPATH_ABS, "kumap.ico"),
)

# onedir：产物是整个文件夹，_internal/ 里放着 Qt 运行库与 kumap/resources。
# 交付时请连目录一起拷贝；PyInstaller 6 起的 _internal 子目录由 paths.py 通过
# sys._MEIPASS 解析，无需手工配置。
coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    name=APP_NAME,
)
